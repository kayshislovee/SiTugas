  "item": [
    {
      "name": "🔑 Setup & Auth",
      "item": [
        {
          "name": "1. GET CSRF Token (Wajib Pertama!)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Ambil XSRF-TOKEN dari cookie dan simpan ke variable",
                  "const cookies = pm.cookies.toObject();",
                  "if (cookies['XSRF-TOKEN']) {",
                  "    const token = decodeURIComponent(cookies['XSRF-TOKEN']);",
                  "    pm.collectionVariables.set('xsrf_token', token);",
                  "    console.log('✅ XSRF Token tersimpan:', token.substring(0, 30) + '...');",
                  "} else {",
                  "    console.log('❌ Cookie XSRF-TOKEN tidak ditemukan. Pastikan server berjalan.');",
                  "}",
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/",
              "host": ["{{base_url}}"],
              "path": [""]
            },
            "description": "Ambil halaman utama untuk mendapatkan cookie XSRF-TOKEN dari Laravel.\nScript otomatis menyimpan token ke variable koleksi."
          }
        },
        {
          "name": "2a. Login Guru",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Refresh CSRF token sebelum login",
                  "const cookies = pm.cookies.toObject();",
                  "if (cookies['XSRF-TOKEN']) {",
                  "    pm.collectionVariables.set('xsrf_token', decodeURIComponent(cookies['XSRF-TOKEN']));",
                  "}"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login berhasil (redirect 302)', () => {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 302]);",
                  "});",
                  "",
                  "if (pm.response.code === 302) {",
                  "    const location = pm.response.headers.get('Location');",
                  "    if (location && location.includes('guru/dashboard')) {",
                  "        console.log('✅ Login guru berhasil! Redirect ke:', location);",
                  "    } else {",
                  "        console.log('⚠️ Redirect ke:', location, '— cek NIP/password');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-XSRF-TOKEN",
                "value": "{{xsrf_token}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Referer",
                "value": "{{base_url}}/login-guru"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "_token",
                  "value": "{{xsrf_token}}",
                  "description": "CSRF token untuk form"
                },
                {
                  "key": "nip",
                  "value": "198501012010011001",
                  "description": "NIP dari UserSeeder"
                },
                {
                  "key": "password",
                  "value": "guru123"
                },
                {
                  "key": "remember",
                  "value": "on",
                  "disabled": true
                }
              ]
            },
            "url": {
