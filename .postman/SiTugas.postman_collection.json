                  "",
                  "if (pm.response.code === 302) {",
                  "    const loc = pm.response.headers.get('Location');",
                  "    pm.test('Redirect ke halaman login (bukan dashboard)', () => {",
                  "        pm.expect(loc).to.not.include('dashboard');",
                  "    });",
                  "    console.log('✅ Login ditolak dengan benar. Redirect ke:', loc);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-XSRF-TOKEN",
                "value": "{{xsrf_token}}"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "_token",
                  "value": "{{xsrf_token}}"
                },
                {
                  "key": "nip",
                  "value": "NIP_YANG_SALAH_999"
                },
                {
                  "key": "password",
                  "value": "passwordsalah"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/login-guru",
              "host": ["{{base_url}}"],
              "path": ["login-guru"]
            },
            "description": "Verifikasi bahwa login dengan NIP salah ditolak dengan benar."
          }
        },
        {
          "name": "POST Buat Tugas — Validasi Gagal (Field Kosong)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const cookies = pm.cookies.toObject();",
                  "if (cookies['XSRF-TOKEN']) {",
                  "    pm.collectionVariables.set('xsrf_token', decodeURIComponent(cookies['XSRF-TOKEN']));",
                  "}"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Validasi menolak form kosong (kembali ke form)', () => {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 302]);",
                  "});",
                  "console.log('Response code:', pm.response.code);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-XSRF-TOKEN",
                "value": "{{xsrf_token}}"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "_token",
                  "value": "{{xsrf_token}}"
                },
                {
                  "key": "judul",
                  "value": "",
                  "description": "Sengaja kosong untuk trigger validasi"
                },
                {
                  "key": "mapel",
                  "value": ""
                },
                {
                  "key": "kelas",
                  "value": ""
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/guru/buat-tugas",
              "host": ["{{base_url}}"],
              "path": ["guru", "buat-tugas"]
            }
          }
        },
        {
          "name": "GET Akses Guru Tanpa Login (Harus Ditolak)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Akses ditolak — redirect ke login (302)', () => {",
                  "    pm.expect(pm.response.code).to.be.oneOf([302, 403]);",
                  "});",
                  "",
                  "if (pm.response.code === 302) {",
                  "    const loc = pm.response.headers.get('Location');",
                  "    console.log('✅ Middleware bekerja. Redirect ke:', loc);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/guru/dashboard",
              "host": ["{{base_url}}"],
              "path": ["guru", "dashboard"]
            },
            "description": "Test ini hanya valid jika kamu BELUM login (atau setelah logout).\n\nHarapan: redirect ke halaman login, bukan 200."
          }
        }
      ]
    }
  ]
}
